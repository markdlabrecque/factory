# systemd user unit: one dispatch pass (start a Sandcastle run per eligible ticket, up to the cap).
# Fired by sandcastle-dispatch.timer. Fill in __REPO__ (the project repo root, where .sandcastle/
# lives, with the integration branch checked out) and __NODE_BIN__ (the directory holding node 22.18+
# and npx). The PATH must also reach glab, claude and docker.
[Unit]
Description=Sandcastle dispatcher

[Service]
Type=oneshot
WorkingDirectory=__REPO__
Environment=SANDCASTLE_STATE_DIR=%h/.local/state/sandcastle
Environment=PATH=__NODE_BIN__:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Runs are detached from the dispatcher so a pass returns quickly; KillMode=process keeps them alive.
KillMode=process
# No terminal here, so dispatch.sh stops instead of building a missing image.
ExecStart=__REPO__/.sandcastle/dispatch.sh
