# systemd user timer for sandcastle-dispatch.service.
# Enable/disable: systemctl --user enable --now sandcastle-dispatch.timer
#                 systemctl --user disable --now sandcastle-dispatch.timer
[Unit]
Description=Run the Sandcastle dispatcher on a schedule

[Timer]
OnBootSec=2min
OnUnitInactiveSec=15min
# A pass that is still running is not started again; the timer re-arms 15 min after it finishes.
Persistent=false

[Install]
WantedBy=timers.target
