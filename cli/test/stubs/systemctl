#!/usr/bin/env node
// Test-owned `systemctl` stub for Factory's scheduler tests. It is a command-boundary stub, NOT systemd: it models only the
// states Factory reads (unit file on disk, enabled, active; the timer's enablement and activity are separate from the tick
// service's activity) and never fires a timer, runs a unit or signals a process. All of its state lives in $STUB_DIR.
// Env: STUB_DIR (calls.jsonl, state.json, fail), STUB_UNIT_DIR (the fixture's ~/.config/systemd/user).
// Every call is appended to calls.jsonl as its exact argv. Anything but the shapes Factory is expected to send is REJECTED
// (exit 64, logged as `rejected`), so a call that would have reached a real manager is visible. A line in $STUB_DIR/fail is an
// exact space-joined argv that exits 1 when called; `once:` in front makes it fail only the first time. In state.json,
// units[<name>].forcedActiveState overrides the reported ActiveState (tests use it to say a tick is running).
// STUB_LEGACY=1 (the cutover rehearsal only) also accepts `disable --now` on a legacy `sandcastle-dispatch[@<name>].timer`,
// the command the runbook has the developer run, and does its one documented effect Factory reads: the timer's
// timers.target.wants symlink is removed. Without it, any call naming a legacy unit is rejected, so Factory never sends one.
const fs = require('node:fs');
const path = require('node:path');
const D = process.env.STUB_DIR, U = process.env.STUB_UNIT_DIR;
if (!D || !U) { console.error('stub: STUB_DIR/STUB_UNIT_DIR unset'); process.exit(70); }
const argv = process.argv.slice(2);
const log = (extra) => fs.appendFileSync(path.join(D, 'calls.jsonl'), JSON.stringify({ argv, ...extra }) + '\n');
const stateFile = path.join(D, 'state.json');
const state = fs.existsSync(stateFile) ? JSON.parse(fs.readFileSync(stateFile, 'utf8')) : { units: {}, reloads: 0 };
const save = () => fs.writeFileSync(stateFile, JSON.stringify(state, null, 2));
const unit = (n) => (state.units[n] ??= { enabled: false, active: false });
const onDisk = (n) => fs.existsSync(path.join(U, n));
const reject = (why) => { log({ rejected: why }); console.error(`stub: rejected ${why}: ${argv.join(' ')}`); process.exit(64); };

const failFile = path.join(D, 'fail');
if (fs.existsSync(failFile)) {
  const lines = fs.readFileSync(failFile, 'utf8').split('\n').filter(Boolean);
  const joined = argv.join(' ');
  const i = lines.findIndex((l) => l.replace(/^once:/, '') === joined);
  if (i >= 0) {
    if (lines[i].startsWith('once:')) { lines.splice(i, 1); fs.writeFileSync(failFile, lines.join('\n') + (lines.length ? '\n' : '')); }
    log({ injectedFailure: true });
    console.error(`stub: injected failure for: ${joined}`);
    process.exit(1);
  }
}
if (argv[0] !== '--user') reject('missing --user');
const [verb, ...rest] = argv.slice(1);
const NAME = /^[A-Za-z0-9@._:-]+\.(service|timer)$/;
const ALLOWED = ['factory-tick.service', 'factory-tick.timer', 'factory-board.service'];
const LEGACY = /^sandcastle-dispatch(@[A-Za-z0-9._-]+)?\.timer$/;
if (process.env.STUB_LEGACY === '1' && argv.length === 4 && argv[1] === 'disable' && argv[2] === '--now' && LEGACY.test(argv[3])) {
  const n = argv[3];
  // An instance's unit file is its template (sandcastle-dispatch@.timer).
  if (!fs.existsSync(path.join(U, n.replace(/@[^.]+\./, '@.')))) { log({ error: 'unit file missing' }); console.error(`Failed to disable unit: Unit file ${n} does not exist.`); process.exit(1); }
  fs.rmSync(path.join(U, 'timers.target.wants', n), { force: true });
  unit(n).enabled = false; unit(n).active = false;
  log({ ok: true }); save(); process.exit(0);
}
switch (verb) {
  case 'show-environment': if (rest.length) reject('show-environment args'); console.log('PATH=/usr/bin'); break;
  case 'daemon-reload': if (rest.length) reject('daemon-reload args'); state.reloads++; break;
  case 'show': {
    const [n, prop, ...more] = rest;
    if (!NAME.test(n ?? '') || !ALLOWED.includes(n) || more.length || !/^--property=[A-Za-z,]+$/.test(prop ?? '')) reject('show shape');
    const u = state.units[n];
    const loaded = onDisk(n);
    const values = {
      LoadState: loaded ? 'loaded' : 'not-found',
      ActiveState: u?.forcedActiveState ?? (u?.active ? 'active' : 'inactive'),
      UnitFileState: loaded ? (u?.enabled ? 'enabled' : 'disabled') : '',
      LastTriggerUSec: u?.lastTrigger ?? 'n/a',
    };
    for (const k of prop.slice('--property='.length).split(',')) { if (!(k in values)) reject(`unknown property ${k}`); console.log(`${k}=${values[k]}`); }
    break;
  }
  case 'enable': case 'disable': {
    const now = rest[0] === '--now';
    const n = now ? rest[1] : rest[0];
    if (!NAME.test(n ?? '') || !ALLOWED.includes(n) || rest.length !== (now ? 2 : 1)) reject(`${verb} shape`);
    if (!onDisk(n)) { log({ error: 'unit file missing' }); console.error(`Failed to ${verb} unit: Unit file ${n} does not exist.`); process.exit(1); }
    unit(n).enabled = verb === 'enable';
    if (now) unit(n).active = verb === 'enable';
    break;
  }
  case 'start': case 'restart': case 'stop': {
    const [n, ...more] = rest;
    if (!NAME.test(n ?? '') || !ALLOWED.includes(n) || more.length) reject(`${verb} shape`);
    if (verb !== 'stop' && !onDisk(n)) { console.error(`Unit ${n} not found.`); process.exit(5); }
    unit(n).active = verb !== 'stop';
    if (verb === 'stop') delete unit(n).forcedActiveState;
    break;
  }
  default: reject(`unknown verb ${verb}`);
}
log({ ok: true });
save();
