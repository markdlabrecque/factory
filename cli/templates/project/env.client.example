# Copy to .env (factory init creates an empty one). .env is gitignored; never commit it.
#
# Client profile: Claude Code runs in the container. Run `claude setup-token` on the host and paste the
# token here. Leave both empty until you have one; dispatch.sh refuses to start without a credential.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# The tracker CLI (glab) runs on the host with its own login; the container needs no tracker token.
GITLAB_TOKEN=
